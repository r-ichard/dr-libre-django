# Development-only values. Never put a real secret here.
SECRET_KEY=development-only-not-a-secret
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=drlibre
DB_USER=drlibre
DB_PASSWORD=drlibre-development
DB_HOST=localhost
DB_PORT=5432
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SENDER=bookings@drlibre.example
PUBLIC_BASE_URL=http://127.0.0.1:8000
